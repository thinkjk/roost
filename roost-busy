#!/usr/bin/env bash
# roost-busy — is it safe to recreate the box right now?
#
# Watchtower pre-update hook (label set in the Dockerfile): exit 75 tells
# Watchtower to skip this container and try again at its next check; 0 lets
# the update go ahead. Any other exit aborts the update, so if this script
# itself breaks, the box stays up rather than being rolled mid-task.
#
# Busy means: a coding agent is running (even idle at its prompt; a recreate
# would kill it; except Claude that herdr reports idle, which AUTO_AGENT
# resumes with --continue after the update), or someone ran `touch ~/.roost-hold` to hold updates by hand
# (`rm ~/.roost-hold` to release). Run it yourself to see what would block.
set -u

# Harness commands. Matched on the program name (argv[0]) and, only when that
# is an interpreter (node, bun, python, ...), the script name (argv[1]); so
# `less claude` or `vim claude.md` is not a hit.
AGENTS="claude codex opencode cursor-agent gemini copilot aider amp qwen crush goose grok pi omp"
HOLD=/home/agent/.roost-hold

HC=/home/agent/.local/bin/hc

# claude_idle /proc/PID: true only when herdr-core reports that process's
# terminal as idle or done (turn finished, waiting at the prompt). Anything
# unclear (not in a herdr terminal, hc missing or failing, another status)
# counts as busy.
claude_idle() {
  local t state
  t="$(tr '\0' '\n' < "$1/environ" 2>/dev/null | sed -n 's/^HC_TERMINAL_ID=//p' | head -n1)"
  [ -n "$t" ] && [ -x "$HC" ] || return 1
  if [ "$(id -u)" = 0 ]; then
    state="$(/usr/sbin/gosu agent env HOME=/home/agent "$HC" get "$t" --json 2>/dev/null | jq -r '.status.state // empty' 2>/dev/null)"
  else
    state="$("$HC" get "$t" --json 2>/dev/null | jq -r '.status.state // empty' 2>/dev/null)"
  fi
  [ "$state" = idle ] || [ "$state" = done ]
}

busy=()
[ -e "$HOLD" ] && busy+=("hold file $HOLD")

for d in /proc/[0-9]*; do
  [ "${d#/proc/}" = "$$" ] && continue
  # argv is NUL-separated; read the first two entries.
  { IFS= read -r -d '' a0 && IFS= read -r -d '' a1 || a1=""; } < "$d/cmdline" 2>/dev/null || continue
  args=("$a0")
  case "${a0##*/}" in node|bun|deno|python|python3|bash|sh) args+=("$a1");; esac
  for arg in "${args[@]}"; do
    name="${arg##*/}"
    for a in $AGENTS; do
      if [ "$name" = "$a" ]; then
        # Claude idle at its prompt in a herdr terminal does not block:
        # AUTO_AGENT brings it back with --continue after the update.
        [ "$a" = claude ] && claude_idle "$d" && break 2
        busy+=("$a (pid ${d#/proc/})"); break 2
      fi
    done
  done
done

if [ "${#busy[@]}" -gt 0 ]; then
  echo "roost busy, update deferred: ${busy[*]}"
  exit 75
fi
echo "roost idle, ok to update"
exit 0
